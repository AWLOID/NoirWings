<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NoirWings.Vm</AssemblyName>
    <RootNamespace>NoirWings.Vm</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The vendored 2019 backend predates nullable annotations. -->
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\third_party\ironbrew-2-master\IronBrew2\**\*.cs"
             Link="Vendor\IronBrew2\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\third_party\ironbrew-2-master\IronBrew2 CLI\bin\Debug\netcoreapp3.1\luac.exe"
             Link="runtime\luac.exe"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\ironbrew-2-master\IronBrew2 CLI\bin\Debug\netcoreapp3.1\luajit.exe"
             Link="runtime\luajit.exe"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\ironbrew-2-master\IronBrew2 CLI\bin\Debug\netcoreapp3.1\lua51.dll"
             Link="runtime\lua51.dll"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\ironbrew-2-master\Lua\Minifier\**\*"
             Link="runtime\Lua\Minifier\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
